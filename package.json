{
  "name": "open-extension",
  "version": "1.2.0",
  "description": "A local OpenCode side panel with active-tab MCP tools and reversible site scripts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bridge": "tsx bridge/index.ts",
    "bridge:built": "node dist/bridge.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptobredda/open-extension.git"
  },
  "homepage": "https://github.com/cryptobredda/open-extension#readme",
  "bugs": {
    "url": "https://github.com/cryptobredda/open-extension/issues"
  },
  "keywords": [
    "opencode",
    "chrome-extension",
    "side-panel",
    "mcp",
    "userscripts"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "^1.19.0",
    "@opencode/client": "^2.0.29",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
